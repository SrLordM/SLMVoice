{
  "schemaVersion": 1,
  "id": "slmvoice",
  "version": "${version}",
  "name": "SLM Voice",
  "description": "Play MP3 and WAV sounds through Simple Voice Chat, with custom keybinds, folders, favorites, and audio editing.",
  "authors": [
    "SrLordM"
  ],
  "contact": {
    "homepage": "https://modrinth.com/mod/slm-voice",
    "sources": "https://github.com/SrLordM/SLMVoice",
    "issues": "https://github.com/SrLordM/SLMVoice/issues"
  },
  "license": "GPL-3.0-only",
  "icon": "assets/slmvoice/icon.png",
  "environment": "client",
  "entrypoints": {
    "preLaunch": [
      {
        "adapter": "kotlin",
        "value": "dev.srlordm.slmvoice.entrypoint.SoundboardPrelaunch"
      }
    ],
    "client": [
      {
        "adapter": "kotlin",
        "value": "dev.srlordm.slmvoice.entrypoint.SVCEntrypoint"
      }
    ],
    "voicechat": [
      {
        "adapter": "kotlin",
        "value": "dev.srlordm.slmvoice.entrypoint.SVCEntrypoint"
      }
    ]
  },
  "mixins": [
    {
      "environment": "client",
      "config": "slmvoice.mixins.json"
    }
  ],
  "depends": {
    "fabricloader": ">=0.19.2",
    "minecraft": "${minecraft}",
    "fabric-language-kotlin": "${flk}",
    "owo-lib": "${owolib}",
    "fabric-api": "*",
    "voicechat": "*"
  },
  "breaks": {
    "slmvoice-svc": "*",
    "soundboard-svc": "*",
    "soundboard-plasmo": "*"
  },
  "accessWidener": "slmvoice.accesswidener"
}
